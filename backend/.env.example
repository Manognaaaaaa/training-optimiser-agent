DATABASE_URL=sqlite:///./training.db
FRONTEND_ORIGIN=http://localhost:5173

# LLM (Phase 5). Leave GROQ_API_KEY empty to disable the planner.
# The model must support tool calling on Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=60
PLANNER_DEFAULT_N=5
PLANNER_MAX_N=10
PLANNER_MAX_STEPS=8
PLANNER_SAMPLE_PAUSE_SECONDS=3
PLANNER_CONTEXT_CHAR_BUDGET=10000

# Calendar sync (Phase 7). See docs/google_calendar_setup.md. The default is a fake in-memory calendar.
CALENDAR_PROVIDER=fake
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=
CALENDAR_TIMEZONE=Asia/Dubai
CALENDAR_SYNC_ENABLED=true
CALENDAR_SYNC_INTERVAL_SECONDS=5
CALENDAR_MAX_ATTEMPTS=5
APP_ENV=dev
APP_BASE_URL=http://localhost:5173
